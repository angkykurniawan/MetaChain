# SUPABASE CREDENTIALS (Database & Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# MULTI-PROVIDER AI CONFIGURATION (Otak AI Mentor di VR)
# 1. Pilih salah satu: 'google' | 'openai' | 'anthropic' | 'deepseek'
VITE_AI_PROVIDER=google

# 2. Pilihan model (opsional):
# Google: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Anthropic: claude-3-5-haiku-latest, claude-3-5-sonnet-latest
# DeepSeek: deepseek-chat, deepseek-coder
VITE_AI_MODEL=gemini-2.5-flash

# 3. Masukkan API Key sesuai provider yang dipilih:
VITE_GEMINI_API_KEY=your-gemini-key-here
VITE_OPENAI_API_KEY=your-openai-key-here
VITE_ANTHROPIC_API_KEY=your-anthropic-key-here
VITE_DEEPSEEK_API_KEY=your-deepseek-key-here
