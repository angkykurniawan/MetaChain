# SUPABASE CREDENTIALS (Database & Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# MULTI-PROVIDER AI CONFIGURATION (Otak AI Mentor di VR)
# Pilih salah satu: 'google' | 'openai' | 'anthropic' | 'deepseek'
VITE_AI_PROVIDER=google

# Masukkan API Key sesuai provider yang dipilih:
VITE_GEMINI_API_KEY=your-gemini-key-here
VITE_OPENAI_API_KEY=your-openai-key-here
VITE_ANTHROPIC_API_KEY=your-anthropic-key-here
VITE_DEEPSEEK_API_KEY=your-deepseek-key-here
